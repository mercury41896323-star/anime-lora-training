{
  "runtime": {
    "name": "rtx3050_6gb_local",
    "max_vram_gb": 6.0,
    "target_gpu_utilization": 0.8,
    "target_gpu_temp_c": 60
  },
  "generation_defaults": {
    "stable_diffusion_family": "sd15",
    "draft_width": 512,
    "draft_height": 512,
    "batch_size": 1,
    "precision": "fp16"
  },
  "bernini_low_vram": {
    "enabled": true,
    "renderer_model": "bernini_r_1.3B-Q4_K_M.gguf",
    "text_encoder": "umt5-xxl-encoder-Q5_K_M.gguf",
    "vae": "wan_2.1_vae.safetensors",
    "width": 512,
    "height": 320,
    "fps": 12,
    "steps": 16,
    "segment_duration_seconds": 1.25,
    "max_duration_seconds": 30.0,
    "max_vram_gb": 5.25,
    "max_ram_gb": 28.0,
    "vae_tile_size": 256,
    "vae_temporal_size": 8,
    "comfyui_startup_args": [
      "--cpu-vae",
      "--cache-none",
      "--disable-smart-memory",
      "--reserve-vram",
      "0.75",
      "--preview-method",
      "none"
    ]
  },
  "training_defaults": {
    "network_module": "lora",
    "train_batch_size": 1,
    "gradient_checkpointing": true,
    "mixed_precision": "fp16",
    "cache_latents": true
  },
  "assets": {
    "raw_dir": "assets/raw",
    "processed_dir": "assets/processed"
  },
  "datasets": {
    "lora_dir": "datasets/lora"
  },
  "models": {
    "wd14_dir": "models/wd14"
  },
  "asset_types": {
    "image_extensions": [".png", ".jpg", ".jpeg", ".webp"],
    "video_extensions": [".mp4", ".mov", ".mkv", ".webm"]
  }
}
